@page "/create"
@page "/edit/{Id:int}"

@inject KooliProjekt.BlazorWasm.IApiClient apiClient
@inject NavigationManager NavManager

<h3>@name</h3>

<EditForm EditContext="editContext" OnSubmit="@FormSubmitted">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <p class="alert-danger">@error</p>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">ID</label>
        <div class="col-sm-10">
            @project.Id
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Title</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="project.Name" />
            <ValidationMessage For="@(() => project.Name)" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-ms-2 col-form-label"></label>
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private string error = "";
    private string name = "Edit";
    private EditContext? editContext;
    private Project project = new Project();

    private ValidationMessageStore? messageStore;

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(project);
        messageStore = new ValidationMessageStore(editContext);

        if (Id == 0)
        {
            name = "Add";
            return;
        }

        var response = await apiClient.Get(Id);
        if (!response.HasErrors)
        {
            project = response.Value;
            editContext = new EditContext(project);
            messageStore = new ValidationMessageStore(editContext);
        }
    }

    private async Task FormSubmitted()
    {
        // Eemalda eelnevad veateated
        messageStore?.Clear();

        var result = await apiClient.Save(project);
        if (!result.HasErrors)
        {
            NavManager.NavigateTo("/lists");
            return;
        }

        foreach (var error in result.Errors)
        {
            messageStore?.Add(new FieldIdentifier(project, string.Empty), error);
        }

        foreach (var error in result.PropertyErrors)
        {
            var propertyName = error.Key[0].ToString().ToUpper() + error.Key.Substring(1);
            messageStore?.Add(new FieldIdentifier(project, propertyName), error.Value);
        }

        // Teavita EditForm'i, et vead on muutunud
        editContext?.NotifyValidationStateChanged();
    }
}
